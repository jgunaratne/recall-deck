# Anthropic API key - enables the Claude chat, quiz generation, and quiz reaction provider.
ANTHROPIC_API_KEY=

# Google Gemini API key - enables the Gemini chat provider and Gemini Live voice tutor.
GEMINI_API_KEY=

# OpenAI API key - enables OpenAI text, card images, and Realtime voice. Card images
# use OpenAI whenever this key is set; otherwise the app uses Gemini if configured.
OPENAI_API_KEY=

# Which provider to use when the client doesn't specify one: "anthropic", "gemini", or "openai".
DEFAULT_AI_PROVIDER=openai

# Optional OpenAI model overrides.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_CHAT_MODEL=
OPENAI_QUIZ_MODEL=
OPENAI_REACTION_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional Gemini image model used when OPENAI_API_KEY is not configured.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional. Set to gate access with a passcode (recommended for public deployments).
DEMO_PASSCODE=
