# Anthropic API key — powers chat, quiz generation, and quiz reactions.
# Required for the default provider.
ANTHROPIC_API_KEY=

# Google Gemini API key — optional. Enables the Gemini chat provider and the
# Gemini Live voice tutor. Leave empty to run Claude-only (no voice tutor).
GEMINI_API_KEY=

# Which provider to use when the client doesn't specify one: "anthropic" (default) or "gemini".
DEFAULT_AI_PROVIDER=anthropic

# Optional. Set to gate access with a passcode (recommended for public deployments).
DEMO_PASSCODE=
